<Application
    x:Class="RadikoUWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RadikoUWP">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="RadikoBlueBrush" Color="#00B4ED"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
            <SolidColorBrush x:Key="TextBrush" Color="#333333"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
